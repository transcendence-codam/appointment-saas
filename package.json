{
  "name": "appointment-saas",
  "private": true,
  "description": "Common package for formatting, linting, pre-commit hooks.",
  "workspaces": [
    "srcs/backend",
    "srcs/frontend",
    "packages/shared"
  ],
  "scripts": {
    "build:shared": "npm run build -w @appointment-saas/shared",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "@nestjs/swagger": "^12.0.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  }
}
