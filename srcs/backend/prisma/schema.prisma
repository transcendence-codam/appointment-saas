// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// tmp tenant table
model Tenant {
  id              String            @id @default(dbgenerated("uuidv7()")) @db.Uuid

  clients         Client[]
  appointments    Appointment[]

  @@map("tenants")
}

model Client {
  id              String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String            @db.Uuid @map("tenant_id")
  email           String            @db.VarChar(255)
  name            String            @db.VarChar(255)
  phone           String?           @db.VarChar(50)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("clients")
}

model Appointment {
  id                        String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId                  String                @db.Uuid @map("tenant_id")
  clientId                  String                @db.Uuid @map("client_id")
  // serviceId                 String                @db.Uuid @map("service_id")
  // staffId                   String                @db.Uuid @map("staff_id")
  startsAt                  DateTime              @db.Timestamptz(3) @map("starts_at")
  endsAt                    DateTime              @db.Timestamptz(3) @map("ends_at")
  status                    AppointmentStatus     @default(confirmed)
  reference                 String                @unique
  serviceNameSnapshot       String?               @db.VarChar(510) @map("service_name_snapshot")
  priceCentsSnapshot        Int?                  @map("price_cents_snapshot")
  createdAt                 DateTime              @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt                 DateTime              @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  tenant                    Tenant                @relation(fields: [tenantId], references: [id])
  client                    Client                @relation(fields: [clientId], references: [id])
  // service                   Service               @relation((fields: [serviceId], references: [id]))
  // staff                     Staff                 @relation(fields: [staffId], references: [id])

  events                    AppointmentEvent[]

  @@index([clientId])
  @@map("appointments")
}

model AppointmentEvent {
  id                     String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  appointmentId          String                  @db.Uuid @map("appointment_id")
  type                   AppointmentEventType
  actor                  Actor
  actorUserId            String?                 @db.Uuid @map("actor_user_id")
  oldStartsAt            DateTime?               @db.Timestamptz(3) @map("old_starts_at")
  newStartsAt            DateTime?               @db.Timestamptz(3) @map("new_starts_at")
  reason                 String?                 @db.VarChar(500)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3) @map("created_at")

  appointment            Appointment             @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@map("appointment_events")
}

enum AppointmentEventType {
  created             @map("created")     // by system (assigned automatically on creation)
  rescheduled         @map("rescheduled") // by staff or client
  cancelled           @map("cancelled")   // by staff or client
  completed           @map("completed")   // by staff or system (automatically after appointment time is 
  noshow              @map("noshow")      // by staff only

  @@map("appointment_event_type")
}

// AS transitions map
// confirmed -> confirmed     rescheduled event
// confirmed -> cancelled     cancelled event
// confirmed -> completed     completed event
// confirmed -> noshow        noshow event
// completed -> noshow        noshow event to fix automatic completed
// cancelled is final
// noshow is final
enum AppointmentStatus {
  confirmed           @map("confirmed")
  completed           @map("completed")
  cancelled           @map("cancelled")
  noshow              @map("noshow")

  @@map("appointment_status")
}

enum Actor {
  staff               @map("staff")
  client              @map("client")
  system              @map("system")

  @@map("actor")
}

// models for users and tenants (jan)
model User {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships Membership[]

  @@map("users")
}

model Tenant {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  slug      String   @unique
  address   String?
  phone     String?
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships Membership[]
  invites     Invite[]

  settings TenantSettings?

  @@map("tenants")
}

enum MembershipRole {
  owner
  employee

  @@map("membership_role")
}

model Membership {
  id        String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model TenantSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  timezone String
  currency String @db.VarChar(3)
  locale   String

  cancelCutoffHours   Int @map("cancel_cutoff_hours")
  minNoticeHours      Int @map("min_notice_hours")
  maxHorizonDays      Int @map("max_horizon_days")
  reminderHoursBefore Int @map("reminder_hours_before")

  autoConfirm Boolean  @default(false) @map("auto_confirm")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model Invite {
  id         String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  email      String
  role       MembershipRole
  tokenHash  String         @unique @map("token_hash")
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime?      @map("accepted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([expiresAt])
  @@map("invites")
}

model Staff {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  membershipId String  @map("membership_id") @db.Uuid
  displayName  String  @map("display_name")
  isActive     Boolean @default(true) @map("is_active")

  services StaffService[]

  @@index([tenantId, isActive])
}

model Service {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  durationMin Int      @map("duration_min")
  priceCents  Int      @map("price_cents")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  staff StaffService[]

  @@index([tenantId, isActive])
}

model StaffService {
  staffId   String @map("staff_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  staff   Staff   @relation(fields: [staffId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@id([staffId, serviceId]) // find all services for this staff member
  @@index([serviceId]) // added this to help find all staff for this service
}
